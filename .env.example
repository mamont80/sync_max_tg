# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
#
# Имя переменной = путь настройки в appsettings.json, где ":" заменено на "__".
# Например Telegram:Webhook:Url -> Telegram__Webhook__Url. Так можно передать ЛЮБУЮ
# настройку приложения, даже если её нет в этом шаблоне.
#
# Кавычки вокруг значений не нужны — docker compose передаёт их как часть значения.
# Файл .env содержит рабочие токены и в git не попадает (см. .gitignore).

# ---------------------------------------------------------------------------
# Токены ботов (обязательно). Пустой токен = соответствующий бот не запускается,
# остальное приложение работает — удобно для отладки одного мессенджера.
# ---------------------------------------------------------------------------
Telegram__Token=
Max__Token=

# ---------------------------------------------------------------------------
# Режим приёма обновлений: LongPolling | Webhook
# LongPolling не требует публичного адреса и проброса порта.
# ---------------------------------------------------------------------------
Telegram__Mode=LongPolling
Max__Mode=LongPolling

# Только для Mode=Webhook: Url — публичный адрес, который регистрируется в мессенджере,
# Path — путь, который слушает контейнер (должен совпадать с путём в Url).
# Секрет отдельно задавать не нужно — он вычисляется из токена бота.
#Telegram__Webhook__Url=https://example.com/webhook/telegram
#Telegram__Webhook__Path=/webhook/telegram
#Max__Webhook__Url=https://example.com/webhook/max
#Max__Webhook__Path=/webhook/max

# ---------------------------------------------------------------------------
# Адреса API (значения по умолчанию обычно менять не нужно)
# ---------------------------------------------------------------------------
# Пусто — официальный https://api.telegram.org; задайте для своего Bot API сервера.
#Telegram__ApiBaseUrl=
#Max__ApiBaseUrl=https://platform-api2.max.ru

# ---------------------------------------------------------------------------
# Фоновая уборка БД: удаление старых записей message_links партиями
# ---------------------------------------------------------------------------
# Сколько суток хранить карту «оригинал ↔ копия». 0 — уборка отключена.
#Cleanup__MessageLinkRetentionDays=14
# Записей за одну транзакцию и паузы между партиями / между проходами.
#Cleanup__BatchSize=200
#Cleanup__BatchPauseSeconds=5
#Cleanup__IdlePauseMinutes=60
#Cleanup__StartupDelaySeconds=60

# ---------------------------------------------------------------------------
# Мини-приложение (веб-интерфейс, открываемый из чата с ботом)
# ---------------------------------------------------------------------------
# Публичный адрес приложения. Тот же домен, что и у webhook, путь /app. Только https:
# без него Telegram не примет кнопку web_app. Пусто — кнопка запуска не выставляется,
# само приложение при этом всё равно раздаётся по /app.
#MiniApp__Url=https://example.com/app

# Сколько часов данные запуска (initData) считаются свежими.
#MiniApp__AuthMaxAgeHours=24

# ТОЛЬКО для отладки: id пользователя, от имени которого работает API, когда приложение
# открыто в обычном браузере (подписанного initData там нет). Пока заполнено — ПОДПИСЬ
# НЕ ПРОВЕРЯЕТСЯ. В рабочей конфигурации оставьте пустым.
#MiniApp__DevUserId=
#MiniApp__DevUserMessenger=tg

# ---------------------------------------------------------------------------
# Прочие настройки приложения
# ---------------------------------------------------------------------------
# Путь к базе внутри контейнера. /data смонтирован в ./data на хосте — менять не нужно.
#Database__ConnectionString=Data Source=/data/syncmax.db

#Logging__LogLevel__Default=Information
#Media__MaxFileMegabytes=45

# ---------------------------------------------------------------------------
# Параметры самого docker compose (в приложение не передаются)
# ---------------------------------------------------------------------------
# Порт на хосте, на который проброшен webhook-порт контейнера (8443).
HTTP_PORT=8443
# Часовой пояс контейнера: время в логах и суточная ротация файлов логов.
TZ=Europe/Moscow
